{
  "name": "pivas-scheduler",
  "productName": "静配中心排班系统",
  "version": "0.1.0",
  "private": true,
  "description": "静配中心排班系统（Electron 22，支持 Win7）",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run typecheck && npm run build:web && npm run build:electron",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win nsis portable --ia32 --x64"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@types/node": "18.19.130",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "22.3.27",
    "electron-builder": "24.13.3",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  },
  "build": {
    "appId": "com.pivas.scheduler",
    "productName": "静配中心排班系统",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "静配排班"
    }
  }
}
